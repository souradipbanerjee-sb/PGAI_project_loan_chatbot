# Copy to .streamlit/secrets.toml for local runs (git-ignored), or paste into Streamlit Cloud -> App settings -> Secrets.
# Never commit real keys.
LLM_PROVIDER = "groq"                 # "groq" or "openai"
GROQ_API_KEY = "gsk_..."
GROQ_MODEL = "openai/gpt-oss-120b"
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4.1-mini"

GSHEET_WEBHOOK_URL = "https://script.google.com/macros/s/XXXX/exec"
GSHEET_TOKEN = "same long random string as TOKEN in apps_script/Code.gs"
